SITE_APP_KEY=
SITE_APP_SECRET=
# Oracle 必须以 thick 模式启动，thin 模式无法连接 Oracle 11g 等旧版实例
ORACLE_THICK_MODE=true
# 实测必需：缺 ORACLE_SCHEMA 时业务表清单为空、概要索引 0 条
# ORACLE_SCHEMA=<业务 schema，Oracle 专用>
# 实测必需：缺 HOME 时附件沙箱全线拒收
HOME=/app/pilot/home
# docker 是密钥可达性的唯一开关；切到其他值会回退到本机执行并暴露密钥
DBGPT_SANDBOX_BACKEND=docker
DBGPT_SANDBOX_IMAGE=dbgpt-sandbox-python:latest
NOTE_BOOK_ENABLE=false
ANONYMIZED_TELEMETRY=False
